$$ # 1 "mc_line 63 file /opt/topspin/exp/stan/nmr/lists/pp/hsqcedetgpsisp2.3 exp. def. part of mc cmd. before ze"
$$ define delay MCWRK
$$ define delay MCREST
$$ define delay d0orig
$$ "d0orig=d0"
$$ define loopcounter t1loop
$$ "t1loop=0"
$$ define loopcounter ph1loop
$$ "ph1loop=0"
$$ define loopcounter ST1CNT
$$ "ST1CNT = td1 / 2"
$$ "MCREST = d1 - d1"
$$ "MCWRK = 0.066667*d1"
$$ 
$$     dccorr
$$ # 63 "/opt/topspin/exp/stan/nmr/lists/pp/hsqcedetgpsisp2.3"
$$ 1 ze
$$ # 1 "mc_line 63 file /opt/topspin/exp/stan/nmr/lists/pp/hsqcedetgpsisp2.3 exp. def. of mc cmd. after ze"
$$       "d0=d0orig + t1loop * in0 "
$$       "phval5 = (ph1loop % 2) * 180"
$$       MCWRK ip5 + phval5
$$       "phval3 = (t1loop * 180)%360"
$$       MCWRK ip3 + phval3
$$       "phval6 = (t1loop * 180)%360"
$$       MCWRK ip6 + phval6
$$       "phval31 = (t1loop * 180)%360"
$$       MCWRK ip31 + phval31
$$       MCWRK
$$       "phval0 = ph1loop * 1"
